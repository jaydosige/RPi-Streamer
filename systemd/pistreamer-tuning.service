[Unit]
Description=pi-streamer host tuning (CPU governor, socket buffers, Wi-Fi power save)
After=network.target
Before=pistreamer.service
Wants=pistreamer.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/pistreamer/bin/pistreamer-tuning
# Settings live here so they can be changed without touching the unit.
EnvironmentFile=-/etc/pistreamer/tuning.conf

[Install]
WantedBy=multi-user.target

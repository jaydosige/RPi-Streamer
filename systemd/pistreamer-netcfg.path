[Unit]
Description=Watch for a pi-streamer network or hostname request
Documentation=man:systemd.path(5)

[Path]
# The service writes this file; this unit notices and runs the root oneshot.
# Path activation is used instead of sudo because pistreamer.service sets
# NoNewPrivileges=yes, which makes any sudo-based escalation impossible, and
# ProtectSystem=full leaves /etc read-only to it.
PathExists=/var/lib/pistreamer/network.request
Unit=pistreamer-netcfg.service

[Install]
WantedBy=multi-user.target
